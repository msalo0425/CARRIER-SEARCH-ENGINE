# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/bcl_db
# OR individual params:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bcl_db
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=24h

# FMCSA API (Socrata)
FMCSA_API_URL=https://data.transportation.gov/resource/az4n-8mr2.json
FMCSA_API_TOKEN=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Nightly sync (cron expression — default 2 AM)
SYNC_CRON=0 2 * * *
SYNC_ENABLED=true
